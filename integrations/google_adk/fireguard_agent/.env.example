GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
FIREGUARD_AGENT_MODEL_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite-preview
FIREGUARD_API_BASE_URL=https://fireguard-api-dovhkdlznq-uc.a.run.app

# Elastic MCP partner integration.
# Option A: streamable HTTP MCP service, preferred for managed Agent Engine.
# FIREGUARD_ELASTIC_MCP_URL=https://your-elastic-mcp-service.run.app/mcp
# FIREGUARD_ELASTIC_MCP_AUTH=google_id_token
# FIREGUARD_ELASTIC_MCP_ID_TOKEN_AUDIENCE=https://your-elastic-mcp-service.run.app
# FIREGUARD_ELASTIC_MCP_ID_TOKEN=optional-local-verification-token
# The connector uses X-Serverless-Authorization for Cloud Run IAM so Elastic MCP
# can keep using its configured Elasticsearch API key.

# Option B: local stdio MCP process for ADK CLI/dev verification.
# FIREGUARD_ELASTIC_MCP_ENABLED=true
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_API_KEY=your-readonly-elastic-api-key
# FIREGUARD_ELASTIC_MCP_COMMAND=npx
# FIREGUARD_ELASTIC_MCP_ARGS=-y @elastic/mcp-server-elasticsearch

# Set true in proof runs so missing MCP config fails instead of silently skipping MCP.
# FIREGUARD_ELASTIC_MCP_REQUIRED=true
