# App
APP_ENV=development
DEMO_MODE=true
DEMO_REGION=bc
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Elastic
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_CLOUD_ID=
ELASTIC_MCP_SERVER_COMMAND=npx
ELASTIC_MCP_SERVER_ARGS=@elastic/mcp-server-elasticsearch

# Fivetran / warehouse ingestion
FIVETRAN_API_KEY=
FIVETRAN_API_SECRET=
FIVETRAN_DESTINATION_NAME=fireguard_bigquery
FIVETRAN_CONNECTION_NAME=fireguard_ingestion
FIVETRAN_CONNECTION_ID=
FIVETRAN_BIGQUERY_PROJECT=
FIVETRAN_BIGQUERY_DATASET=fireguard_ingestion

# NASA FIRMS
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_SOURCE=VIIRS_SNPP_NRT
NASA_FIRMS_BBOX=-122.2,52.0,-121.3,52.9

# Google Cloud / Gemini
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_ASSESSMENT_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=

# Google Routes
GOOGLE_MAPS_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ALLOWLIST=+15555550123,+15555550124
DEMO_RESIDENT_ZONE_A_PHONE=

# Arize Phoenix
PHOENIX_TRACING_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=fireguard
PHOENIX_API_KEY=

# Demo action webhooks
ACTION_WEBHOOK_SECRET=dev-secret
SHELTER_WEBHOOK_URL=
ROAD_OPS_WEBHOOK_URL=
DISPATCH_WEBHOOK_URL=
